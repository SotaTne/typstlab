{
  "name": "typstlab-github-scripts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "build:index": "bun --filter '*' build:index",
    "build:cli": "bun --filter '*' build:cli",
    "json-check:schema": "bun --filter '@typstlab/toolchain-monitor' json-check:schema",
    "json-check:files": "bun --filter '@typstlab/toolchain-monitor' json-check:files",
    "json-check": "bun run json-check:schema && bun run json-check:files"
  },
  "devDependencies": {
    "@actions/core": "latest",
    "@actions/exec": "latest",
    "@actions/github": "latest",
    "@actions/github-script": "github:actions/github-script",
    "@actions/glob": "latest",
    "@actions/io": "latest",
    "@types/bun": "latest",
    "commander": "^14.0.3",
    "typescript": "^6"
  }
}
